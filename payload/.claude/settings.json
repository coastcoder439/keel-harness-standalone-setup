{
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/session-roles.js\"",
            "timeout": 10,
            "statusMessage": "Sitzungs-Rollen laden"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/onboarding-start.js\"",
            "timeout": 10,
            "statusMessage": "Installationsprofil offen?"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/project-context.js\"",
            "timeout": 10,
            "statusMessage": "Projekt-Kontext-Check"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/pollution-warn.js\"",
            "timeout": 10,
            "statusMessage": "User-Scope-Verschmutzung messen"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/prompt-form.js\"",
            "timeout": 10,
            "statusMessage": "Antwortform-Kurzform (jede Runde)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/unlazy-stop.js\"",
            "timeout": 20,
            "statusMessage": "Unlazy: offene Gates, Leaves und Dispatch-Waves"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/dod-guard.js\"",
            "timeout": 10,
            "statusMessage": "dod-guard (Abschluss-Format bei geleisteter Arbeit)"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/uncommitted-warn.js\"",
            "async": true,
            "timeout": 15,
            "statusMessage": "Backup-Check (ungesicherte Arbeit)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/git-intent-guard.js\"",
            "timeout": 10,
            "statusMessage": "Git-Intent statt Befehlsroulette"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/shell-mutation-guard.js\"",
            "timeout": 10,
            "statusMessage": "Endliche Shell-Mutationsgrenze"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/danger-guard.js\"",
            "timeout": 10,
            "statusMessage": "danger-guard (nicht-Git-Zerstoerung)"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/write-guard.js\"",
            "timeout": 10,
            "statusMessage": "write-guard (Schreibziel, Zugaenge, gitignore-Reihenfolge)"
          }
        ]
      },
      {
        "matcher": "mcp__ccd_session_mgmt__(send_message|list_sessions)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/sessionpost-guard.js\"",
            "timeout": 10,
            "statusMessage": "sessionpost-guard (knappe Inter-Session-Nachrichten)"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/paket-gate.js\"",
            "timeout": 10,
            "statusMessage": "Repo- und Bundle-Zuordnung"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/mcp-write-guard.js\"",
            "timeout": 10,
            "statusMessage": "mcp-write-guard (MCP-Schreibgrenze bei aktivem Paket)"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_PROJECT_DIR/.claude/statusline.js\""
  }
}
