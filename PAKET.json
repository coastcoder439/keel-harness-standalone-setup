  "bewusstNichtEnthalten": [
    {
      "was": ".claude/pruefstand-warn.js",
      "grund": "braucht zwei Pruefwerkzeuge, die ihrerseits den ECC-Fremd-Klon brauchen; ohne sie meldet der Stop-Hook bei jedem Lauf einen Stacktrace als Befund"
    },
    {
      "was": "docs/workflows/*.js",
      "grund": "Werkbank-eigene Pruefer; einer bricht ohne .ecc-src/ mit Exit 2 ab, der andere prueft eine Zusage, die nur in der Ursprungs-Werkbank gilt"
    },
    {
      "was": ".claude/skills/skill-library/",
