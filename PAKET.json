    },
    {
      "was": "permissions / skillOverrides / enabledPlugins",
      "grund": "rechner- und personenbezogen; ausgeliefert erteilten sie stillschweigend Rechte"
    },
    {
      "was": "docs/08-sessions-rollen.md",
      "grund": "Rollen der Ursprungs-Werkbank; fehlt die Datei, bleibt der Hook still — das ist das richtige Verhalten"
