  "hinweisZurZaehlung": "posten = alle Dateien im Paket ausser manifest.json selbst (ohne .git und node_modules). bytes und sha256 messen den auf LF vereinheitlichten Inhalt, damit sie plattformstabil sind. Erzeugt von checks/paket-manifest.mjs --nachziehen; in der Abnahme wird gegengeprueft.",
  "ersetzungen": 71,
  "bewusstNichtEnthalten": [
    {
      "was": ".claude/pruefstand-warn.js",
      "grund": "braucht zwei Pruefwerkzeuge, die ihrerseits den ECC-Fremd-Klon brauchen; ohne sie meldet der Stop-Hook bei jedem Lauf einen Stacktrace als Befund"
    },
    {
      "was": "docs/workflows/*.js",
      "grund": "Werkbank-eigene Pruefer; einer bricht ohne .ecc-src/ mit Exit 2 ab, der andere prueft eine Zusage, die nur in der Ursprungs-Werkbank gilt"
    },
    {
      "was": ".claude/skills/skill-library/",
      "grund": "Index von 245 Skills des ECC-Fremd-Klons; im Paket zeigt jeder Eintrag ins Leere"
    },
    {
      "was": ".ecc-src/ und die Kopien daraus",
      "grund": "Fremd-Klon (eigene Lizenz, 227 MB) — wird beim Onboarding selbst geholt, nicht mitgeliefert"
    },
    {
      "was": "permissions / skillOverrides / enabledPlugins",
      "grund": "rechner- und personenbezogen; ausgeliefert erteilten sie stillschweigend Rechte"
    },
    {
      "was": "docs/08-sessions-rollen.md",
      "grund": "Rollen der Ursprungs-Werkbank; fehlt die Datei, bleibt der Hook still — das ist das richtige Verhalten"
    }
